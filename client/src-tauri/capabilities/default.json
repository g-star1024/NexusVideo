{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NexusVideo 默认能力集：IPC 命令白名单 + 插件权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:default",
    "core:app:default",
    "core:path:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "process:allow-exit",
    "process:allow-restart",
    "log:default",
    "updater:default",
    "allow-start-backend",
    "allow-stop-backend",
    "allow-get-backend-status",
    "allow-generate-video",
    "allow-query-task",
    "allow-cancel-task",
    "allow-get-models",
    "allow-get-app-info",
    "allow-open-output-dir",
    "allow-init-app",
    "allow-get-init-status",
    "allow-get-process-status",
    "allow-start-backend-full",
    "allow-get-disk-space",
    "allow-get-video-list",
    "allow-cleanup-old-files",
    "allow-evict-thumbnails",
    "allow-read-settings",
    "allow-write-settings",
    "allow-upload-file",
    "allow-move-uploaded-file",
    "allow-listen-progress",
    "allow-stop-progress",
    "allow-auto-update-ipc-check",
    "allow-auto-update-ipc-download",
    "allow-auto-update-ipc-restart",
    "allow-reload-frontend",
    "allow-get-crash-reports",
    "allow-clear-crash-reports",
    "allow-get-default-install-dir",
    "allow-audit-install-dir",
    "allow-pick-install-dir",
    "allow-start-install",
    "allow-verify-install",
    "allow-listen-install-progress",
    "allow-stop-install-progress"
  ]
}
