{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NexusVideo 默认能力集：IPC 命令白名单 + 插件权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:default",
    "core:app:default",
    "core:path:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "process:allow-exit",
    "process:allow-restart",
    "log:default",
    "updater:default"
  ]
}
