{
  "$schema": "https://schema.tauri.app/config/2",

  "productName": "NexusVideo",
  "version": "0.1.14",
  "identifier": "com.nexusvideo.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "title": "NexusVideo",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://*; media-src 'self' blob: file: https://*; connect-src 'self' http://127.0.0.1:8188 http://127.0.0.1:9881 http://127.0.0.1:9882 ws://127.0.0.1:8188 ws://127.0.0.1:9881 http://localhost:9881 ws://localhost:9881 https://*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },

  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://releases.nexusvideo.com/update.json"],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3MzQ2RUY4N0NGNzk4RgpSV1NQZWMrSDcwWnpBcEI5MlRpK0JzR2lDTjJNWThsY1U4VjBSWGlvVHZKSW45N3UvSEkwQXd5Sgo=",
      "windows": {
        "installMode": "passive"
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],

    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/256x256@2x.png",
      "icons/512x512.png",
      "icons/512x512@2x.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../resources/python_env",
      "../../resources/backend"
    ],
    "copyright": "© 2026 NexusVideo",
    "category": "Productivity",

    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "languages": ["SimpChinese", "English"],
        "installerHooks": null
      }
    },

    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "exceptionDomain": "com.nexusvideo.client",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": { "width": 600, "height": 400 }
      }
    }
  }
}
