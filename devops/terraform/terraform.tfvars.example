# NexusVideo Terraform 变量示例文件
# 使用方法：复制本文件为 terraform.tfvars.staging 或 terraform.tfvars.production
#           terraform plan -var-file="terraform.tfvars.staging"
#           terraform apply -var-file="terraform.tfvars.staging"

# ============================================================
# 全局
# ============================================================
region = "cn-shenzhen"
env    = "staging"   # staging / production

# ============================================================
# VPC
# ============================================================
vpc_cidr            = "10.0.0.0/16"
gpu_zone            = "cn-shenzhen-d"
general_zone        = "cn-shenzhen-a"
gpu_subnet_cidr     = "10.0.1.0/24"
general_subnet_cidr = "10.0.2.0/24"

# ============================================================
# NAS
# ============================================================
nas_size_gb = 100   # 容量型，约 ¥20/月

# ============================================================
# GPU 实例
# ============================================================
gpu_instance_type      = "gn5i-c16g1.4xlarge"   # 包月基线 A10 × 1
gpu_spot_instance_type = "gfn7-c16g1.4xlarge"   # 抢占式 A10 弹性池
gpu_image_id           = "m-cn-shenzhen-xxxxxxxxx"  # 替换为实际镜像 ID

# ============================================================
# ESS 弹性伸缩
# ============================================================
ess_min_size         = 1
ess_max_size         = 10
ess_cooldown         = 300
ess_scale_up_delta   = 2
ess_scale_down_delta = 1

# ============================================================
# RDS
# ============================================================
rds_instance_type = "rds.mysql.t2.small"   # staging 入门级
rds_storage_gb    = 20
db_password       = "Staging_DB_2024!"     # 生产环境请使用 Secrets Manager

# ============================================================
# Redis
# ============================================================
redis_instance_type = "redis.basic.2c.xd"
redis_capacity_gb   = 1

# ============================================================
# SLB
# ============================================================
slb_bandwidth_mbps = 100

# ============================================================
# 运维
# ============================================================
admin_cidr = "0.0.0.0/0"   # staging 宽松；production 建议改为公司 VPN CIDR

# ============================================================
# OSS
# ============================================================
oss_bucket_suffix = "outputs"