# NexusVideo Inference Gateway Dockerfile
# 部署到阿里云 ACR，K8s Deployment 拉取运行

FROM python:3.12-slim

LABEL maintainer="NexusVideo DevOps"
LABEL description="NexusVideo Inference Gateway (FastAPI)"

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY inference_gateway.py .
COPY models/ ./models/

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["uvicorn", "inference_gateway:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]