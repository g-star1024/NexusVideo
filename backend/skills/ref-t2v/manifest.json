    },
    {
      "name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "clip",
      "min_vram_mb": 2000,
      "source": "https://huggingface.co/Comfy-Org/Wan_2.1_ComfyUI_Repackaged"
    },
    {
      "name": "wan_2.1_vae.safetensors",
      "type": "vae",
