      "source": "https://huggingface.co/Comfy-Org/Wan_2.1_ComfyUI_Repackaged"
    }
  ],
  "required_custom_nodes": [
    "ComfyUI-WanVideoWrapper"
  ],
  "default_params": {
    "width": 832,
    "height": 480,
    "frames": 81,
