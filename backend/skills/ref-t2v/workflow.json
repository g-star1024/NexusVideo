{
  "1": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "inputs": {
      "model_name": "umt5_xxl_fp8_e4m3fn.safetensors",
      "precision": "bf16",
      "load_device": "offload_device",
      "quantization": "disabled"
    }
  },
  "2": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "wan2.1-t2v-1.3b_fp16.safetensors",
      "base_precision": "fp16",
      "quantization": "disabled",
      "load_device": "offload_device"
    }
  },
  "3": {
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "model_name": "wan_2.1_vae.safetensors",
      "precision": "fp16"
    }
  },
  "4": {
    "class_type": "WanVideoTextEncode",
    "inputs": {
      "positive_prompt": "{{prompt}}",
      "negative_prompt": "{{negative_prompt}}",
      "t5": ["1", 0],
      "force_offload": true,
      "device": "gpu"
    }
  },
  "5": {
    "class_type": "WanVideoEmptyEmbeds",
    "inputs": {
      "width": "__INT__width",
      "height": "__INT__height",
      "num_frames": "__INT__frames"
    }
  },
  "6": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["2", 0],
      "image_embeds": ["5", 0],
      "text_embeds": ["4", 0],
      "steps": "__INT__steps",
      "cfg": 6.0,
      "shift": 5.0,
      "seed": "__INT__seed",
      "force_offload": true,
      "scheduler": "unipc",
      "riflex_freq_index": 0
    }
  },
  "7": {
    "class_type": "WanVideoDecode",
    "inputs": {
      "vae": ["3", 0],
      "samples": ["6", 0],
      "enable_vae_tiling": true,
      "tile_x": 272,
      "tile_y": 272,
      "tile_stride_x": 144,
      "tile_stride_y": 128
    }
  },
  "10": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["7", 0],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "nexus_t2v",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
